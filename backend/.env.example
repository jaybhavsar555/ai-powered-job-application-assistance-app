# Backend Environment Variables

# Database settings
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aijobdb
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Security (Change this in production!)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Dual LLM profiles (Canvas can switch live) ---
# tokenharbor | ollama | openai
LLM_PROVIDER=tokenharbor
OPENAI_BASE_URL=
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_FORCE_MOCK=false
# Keep false in daily use — silent mock agent JSON hides real failures.
LLM_ALLOW_MOCK=false

# Token Harbor — OpenAI-compatible gateway (https://tokenharbor.ai/dashboard/api-keys)
# Best for Career OS agents when OpenAI has no credits / Ollama is slow on CPU.
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
# Prefer a chat model for structured JSON (Discovery / Canvas / Quick Apply).
# th-orchestra is for coding agents; without tools it uses the Chat pool.
# Prefer free ids for daily agents: kimi-k3:free | deepseek-v4-flash:free | mimo-v2.5:free
# Paid if needed: deepseek-v4-flash | gpt-5.6-luna | claude-sonnet-5 | th-orchestra
# Catalog: https://tokenharbor.ai/docs/api/models
TOKENHARBOR_MODEL=kimi-k3:free
TOKENHARBOR_TIMEOUT_SECONDS=90
TOKENHARBOR_MAX_TOKENS=1200

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MAX_TOKENS=400
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=30m
# First structured call often needs several minutes on CPU after cold load
OLLAMA_TIMEOUT_SECONDS=300

# Docker Compose overrides LLM_PROVIDER=ollama and OLLAMA_BASE_URL=http://ollama:11434/v1.
# Prefer Ollama when OpenAI has no credits. Mock output is off (LLM_ALLOW_MOCK=false).

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
# Local embed alternative: nomic-embed-text / 768

# Application Settings
ENVIRONMENT=development
# Next.js on host (3000 default, or 3001 if busy)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Demo login + password seed (auto-off when ENVIRONMENT=production)
ALLOW_DEMO_AUTH=true
SEED_DEV_USERS=true

# Resume library + packages — Compose mounts ./data/resumes and ./data/packages
RESUME_SOURCE_DIR=./data/resumes
APPLICATION_PACKAGE_DIR=./data/packages

# Optional SMTP (empty = copy/mailto for outreach — still usable daily)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional Hunter.io domain-search for recruiter emails (empty = paste contact in Outreach)
HUNTER_API_KEY=

# Gated Auto Apply (extension; LinkedIn blocked by default)
AUTO_APPLY_ENABLED=true
AUTO_APPLY_REQUIRE_CONSENT=true
AUTO_APPLY_MAX_PER_HOUR=8
AUTO_APPLY_MAX_PER_DAY=30
AUTO_APPLY_MIN_CONFIDENCE=0.72

# Discovery — Vault job_portal KBs primary; remote boards secondary fill
JOB_DISCOVERY_SOURCES=vault_portals,remotive,remoteok,arbeitnow
JOB_DISCOVERY_PER_SOURCE=3
JOB_DISCOVERY_VAULT_LIMIT=12
JOB_DISCOVERY_MAX_RESULTS=15

# Backend Environment Variables

# Database settings
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aijobdb
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Security (Change this in production!)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Pick ONE LLM block ---

# A) OpenAI cloud — leave OPENAI_BASE_URL empty (required for correct Instructor mode)
OPENAI_BASE_URL=
OPENAI_API_KEY=sk-your-openai-api-key
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_FORCE_MOCK=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536

# B) Local Ollama — comment block A, uncomment below
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
# LLM_TIMEOUT_SECONDS=45
# LLM_MAX_TOKENS=700
# LLM_FORCE_MOCK=false
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMS=768

# Application Settings
ENVIRONMENT=development

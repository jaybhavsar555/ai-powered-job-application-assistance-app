# Backend Environment Variables

# Database settings
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/aijobdb
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Security (Change this in production!)
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Dual LLM profiles (Canvas can switch live) ---
LLM_PROVIDER=openai
OPENAI_BASE_URL=
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
LLM_MODEL=gpt-4o
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_FORCE_MOCK=false

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MAX_TOKENS=320
OLLAMA_NUM_CTX=2048
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT_SECONDS=90

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMS=1536
# Local embed alternative: nomic-embed-text / 768

# Application Settings
ENVIRONMENT=development
# Comma-separated; leave as localhost for local Next.js
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Demo login + password seed (auto-off when ENVIRONMENT=production)
ALLOW_DEMO_AUTH=true
SEED_DEV_USERS=true

# Resume library + per-company packages (Docker: /data/resumes, /data/packages)
RESUME_SOURCE_DIR=./data/resumes
APPLICATION_PACKAGE_DIR=./data/packages

# Optional SMTP (empty = copy/mailto for outreach — still usable daily)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Gated Auto Apply (extension; LinkedIn blocked by default)
AUTO_APPLY_ENABLED=true
AUTO_APPLY_REQUIRE_CONSENT=true
AUTO_APPLY_MAX_PER_HOUR=8
AUTO_APPLY_MAX_PER_DAY=30
AUTO_APPLY_MIN_CONFIDENCE=0.72

# Discovery sources
JOB_DISCOVERY_SOURCES=remotive,remoteok,arbeitnow
JOB_DISCOVERY_PER_SOURCE=4

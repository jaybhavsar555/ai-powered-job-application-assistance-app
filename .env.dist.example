# Career OS distributable stack — copy to .env.dist and edit secrets.
# Used by docker-compose.dist.yml + scripts/dist-setup.*

POSTGRES_USER=career
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=aijobdb
REDIS_PASSWORD=change-me-strong-redis-password

SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ENVIRONMENT=production
ALLOW_DEMO_AUTH=false
SEED_DEV_USERS=false

API_PORT=8001
WEB_PORT=3000
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen2.5:3b
LLM_PROVIDER=ollama
LLM_FORCE_MOCK=false
LLM_ALLOW_MOCK=false

# Optional OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Optional Token Harbor gateway (https://tokenharbor.ai/dashboard/api-keys)
# LLM_PROVIDER=tokenharbor
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=kimi-k3:free

# Optional: Hunter.io for recruiter email finder (Companies / Canvas discovery)
HUNTER_API_KEY=

# Discovery: Vault job_portal KBs primary; remote boards fill remaining slots
JOB_DISCOVERY_SOURCES=vault_portals,remotive,remoteok,arbeitnow
JOB_DISCOVERY_PER_SOURCE=3
JOB_DISCOVERY_VAULT_LIMIT=12
JOB_DISCOVERY_MAX_RESULTS=15

RESUME_HOST_DIR=./data/resumes
PACKAGE_HOST_DIR=./data/packages
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# Optional SMTP for real send-with-attachment (otherwise mailto / Gmail + download PDF)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Pre-built images (optional — leave empty to build locally)
# API_IMAGE=youruser/career-os-api:1.0.0
# WEB_IMAGE=youruser/career-os-web:1.0.0

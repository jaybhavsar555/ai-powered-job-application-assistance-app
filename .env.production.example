# Copy to .env.production and fill in secrets. Never commit real values.

POSTGRES_USER=career
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=aijobdb

REDIS_PASSWORD=change-me-strong-redis-password

# At least 32 random characters — required for API boot in production
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars

# Explicit frontend origin(s), comma-separated — required (never *)
CORS_ORIGINS=http://localhost:3000

# API / Web published ports on the host
API_PORT=8001
WEB_PORT=3000

# Browser-reachable API URL (used at Next.js build time)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# LLM — Ollama inside compose (default) or OpenAI cloud
LLM_PROVIDER=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=gpt-4o
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768
CHECKPOINT_BACKEND=postgres
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Host folder mounted into the API container for resumes/packages
RESUME_HOST_DIR=./data/resumes
RESUME_SOURCE_DIR=/data/resumes
APPLICATION_PACKAGE_DIR=/data/resumes

# Optional SMTP — leave empty to use copy/mailto for outreach (recommended for v1)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Copy to .env.production and fill in secrets. Never commit real values.

POSTGRES_USER=career
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=aijobdb

REDIS_PASSWORD=change-me-strong-redis-password

SECRET_KEY=change-me-long-random-secret-key

# API / Web published ports on the host
API_PORT=8001
WEB_PORT=3000

# Browser-reachable API URL (used at Next.js build time)
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1

# LLM — Ollama inside compose (default) or OpenAI cloud
# Switch at runtime: PUT /api/v1/llm/provider {"provider":"openai"|"ollama"|"mock"}
LLM_PROVIDER=ollama
OPENAI_BASE_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=gpt-4o
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMS=768
CHECKPOINT_BACKEND=postgres
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Host-mounted resume library (optional; used by apply-package on the API host)
RESUME_SOURCE_DIR=/data/resumes
APPLICATION_PACKAGE_DIR=/data/resumes

# Frontend Environment Variables
# Prefer same-origin proxy (Next rewrite → Docker API on host port 8001).
NEXT_PUBLIC_API_URL=/api/v1

# If port 3000 is taken (another app), run: npm run dev -- -p 3001
# and open http://localhost:3001 — CORS already allows 3000 and 3001.

# Direct URL only if you disable next.config.mjs rewrites:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api/v1
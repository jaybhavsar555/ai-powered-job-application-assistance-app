{
  "manifest_version": 3,
  "name": "Career OS Autofill",
  "version": "1.1.0",
  "description": "Autofill ATS forms and attach resume. You click Submit (unless gated Auto).",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:8001/*",
    "http://127.0.0.1:8001/*"
  ],
  "action": {
    "default_title": "Career OS Autofill",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
